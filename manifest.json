{
  "manifest_version": 3,
  "name": "网页内容抓取器",
  "version": "1.0.0",
  "description": "一键提取并复制网页正文，支持纯文本和 Markdown 格式",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "tabs", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "打开抓取面板"
    }
  }
}
